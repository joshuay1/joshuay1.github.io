<div class="publication-filters" hidden>
  <fieldset class="publication-topic-controls">
    <legend>Explore by topic</legend>
    <p class="publication-filter-hint">Choose topics to show papers matching any of your interests.</p>
    <div class="publication-topic-options">
      <button type="button" data-publication-topic="all" aria-pressed="true">All topics</button>
      {% for topic in site.data.publication_topics.topics %}
        <button type="button" data-publication-topic="{{ topic.id }}" aria-pressed="false">{{ topic.label }}</button>
      {% endfor %}
    </div>
  </fieldset>
  <div class="publication-filter-toolbar">
    <label>
      Sort by
      <select data-publication-sort>
        <option value="newest">Newest first</option>
        <option value="oldest">Oldest first</option>
        <option value="title">Title A–Z</option>
      </select>
    </label>
    <p class="publication-filter-count" role="status" aria-live="polite" aria-atomic="true"></p>
    <button type="button" class="publication-filter-reset" hidden>Reset filters</button>
  </div>
</div>
<p class="publication-filter-empty" hidden>
  No papers match these topics{% if include.selected %} in this selection{% endif %}.
</p>
{% if include.selected %}
  <p class="publication-browse-all"><a href="{{ '/pubs/' | relative_url }}" data-publication-browse-all>Browse all publications →</a></p>
{% endif %}
