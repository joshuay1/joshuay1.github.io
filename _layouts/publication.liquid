---
layout: default
---
{% assign publication = site.data.publications[page.bibkey] %}

{% if publication %}
  <article class="publication-page" itemscope itemtype="https://schema.org/ScholarlyArticle">
    <a class="publication-back-link" href="{{ '/pubs/' | relative_url }}">← Publications</a>

    <header class="publication-header">
      <h1 itemprop="headline">{{ publication.title }}</h1>
      <p class="publication-authors" itemprop="author">{{ publication.author_text }}</p>
      <p class="publication-venue">
        {{ publication.venue }}
        {% if publication.year %}
          {% unless publication.venue contains publication.year %}
            {% if publication.venue %} · {% endif -%}
            {{- publication.year }}
          {% endunless %}
        {% endif %}
      </p>
      {% if publication.pdf_url or publication.source_url %}
        <nav class="publication-links" aria-label="Paper links">
          {% if publication.pdf_url %}
            {% assign pdf_url = publication.pdf_url %}
            {% unless pdf_url contains '://' %}{% assign pdf_url = pdf_url | relative_url %}{% endunless %}
            <a href="{{ pdf_url }}">Read the paper (PDF)</a>
          {% endif %}
          {% if publication.source_url and publication.source_url != publication.pdf_url %}
            <a href="{{ publication.source_url }}">
              {%- if publication.arxiv -%}arXiv{%- elsif publication.doi -%}Published paper{%- else -%}Read the paper{%- endif -%}
            </a>
          {% endif %}
        </nav>
      {% endif %}
    </header>

    <div class="publication-text">
      {% if publication.abstract %}
        <section aria-labelledby="abstract">
          <h2 id="abstract">Abstract</h2>
          <p itemprop="abstract">{{ publication.abstract }}</p>
        </section>
      {% endif %}
      {{ content }}
    </div>
  </article>
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
    </header>
    <article>{{ content }}</article>
  </div>
{% endif %}
