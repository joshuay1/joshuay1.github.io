---
layout: default
---
{% assign publication = site.data.publications[page.bibkey] %}

{% if publication %}
  <article class="publication-page" itemscope itemtype="https://schema.org/ScholarlyArticle">
    <a class="publication-back-link" href="{{ '/pubs/' | relative_url }}">← Publications</a>

    <header class="publication-header">
      <h1 itemprop="headline">{{ publication.title }}</h1>
      <p class="publication-authors" itemprop="author">{{ publication.author_text }}</p>
      <p class="publication-venue">
        {{ publication.venue }}
        {% if publication.year %}
          {% unless publication.venue contains publication.year %}
            {% if publication.venue %} · {% endif -%}
            {{- publication.year }}
          {% endunless %}
        {% endif %}
      </p>
      {% if publication.pdf_url or publication.source_url or publication.apa or publication.bibtex %}
        <nav class="publication-links" aria-label="Paper links">
          {% if publication.pdf_url %}
            {% assign pdf_url = publication.pdf_url %}
            {% unless pdf_url contains '://' %}{% assign pdf_url = pdf_url | relative_url %}{% endunless %}
            <a href="{{ pdf_url }}">Download PDF</a>
          {% endif %}
          {% if publication.source_url and publication.source_url != publication.pdf_url %}
            <a href="{{ publication.source_url }}">
              {%- if publication.arxiv -%}arXiv{%- elsif publication.doi -%}Published paper{%- else -%}Read the paper{%- endif -%}
            </a>
          {% endif %}
          {% if publication.apa or publication.bibtex %}
            <a href="#cite-this-paper">Cite this paper</a>
          {% endif %}
        </nav>
      {% endif %}
    </header>

    <div class="publication-text">
      {% if publication.abstract and page.full_paper != true %}
        <section aria-labelledby="abstract">
          <h2 id="abstract">Abstract</h2>
          <p itemprop="abstract">{{ publication.abstract }}</p>
        </section>
      {% endif %}
      {{ content }}
    </div>
    {% if publication.apa or publication.bibtex %}
      <section class="paper-citation" id="cite-this-paper" aria-labelledby="paper-citation-title">
        <h2 id="paper-citation-title">Cite this paper</h2>
        {% if publication.apa %}
          <p id="paper-citation-text">{{ publication.apa | escape }}</p>
          <button type="button" class="paper-copy-button" data-copy-target="paper-citation-text">Copy citation</button>
        {% endif %}
        {% if publication.bibtex %}
          <details class="paper-bibtex">
            <summary>BibTeX</summary>
            <pre><code id="paper-bibtex-text">{{ publication.bibtex | escape }}</code></pre>
            <button type="button" class="paper-copy-button" data-copy-target="paper-bibtex-text">Copy BibTeX</button>
            <button type="button" class="paper-copy-button" data-download-bibtex="{{ publication.slug | escape }}">Download .bib</button>
          </details>
        {% endif %}
        <p class="paper-copy-status" role="status" aria-live="polite"></p>
      </section>
      <script defer src="{{ '/assets/js/paper-citation.js' | relative_url }}"></script>
    {% endif %}
  </article>
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
    </header>
    <article>{{ content }}</article>
  </div>
{% endif %}
